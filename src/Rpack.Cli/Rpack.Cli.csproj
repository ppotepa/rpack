<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <ProjectReference Include="..\Rpack.Core\Rpack.Core.csproj" />
    <ProjectReference Include="..\Rpack.App\Rpack.App.csproj" />
    <ProjectReference Include="..\Rpack.AgentPackages\Rpack.AgentPackages.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>rpack</AssemblyName>
    <RootNamespace>Rpack.Cli</RootNamespace>
    <Version>0.1.23</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Pawel Potepa</Authors>
    <Description>Portable, validated patch packages for Git working trees.</Description>
    <PackageId>rpack</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>git;patch;cli;repository</PackageTags>
    <RepositoryUrl>https://github.com/ppotepa/rpack</RepositoryUrl>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rpack</ToolCommandName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' Or '$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'win-arm64'">
    <ApplicationIcon>..\..\assets\rpack.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\rpack.svg" Pack="true" PackagePath="assets\" />
  </ItemGroup>

</Project>

